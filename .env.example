# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server listening port (must be 3000 in AI Studio).
PORT="3000"

# DB_PATH: Local SQLite database file path.
DB_PATH="./data/portfolio.db"

# ADMIN_USERNAME, ADMIN_EMAIL & ADMIN_PASSWORD: Private credentials for the /studio-login panel.
# Never expose these in client code. Password is hashed with bcrypt on the server.
ADMIN_USERNAME="your_admin_username"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_strong_admin_password"

# JWT_SECRET: Random 64-character secret used to sign httpOnly session cookies.
JWT_SECRET="replace_with_a_long_random_secret_string"

# ALLOWED_ORIGINS: Optional comma-separated list of extra allowed frontend origins for CORS.
# Example: "https://your-custom-domain.com,https://www.your-custom-domain.com"
ALLOWED_ORIGINS=""

# CONTACT_RECIPIENT_EMAIL: Optional override for contact form destination email.
# Defaults to the contact email stored in site settings (surmilanodi5@gmail.com).
CONTACT_RECIPIENT_EMAIL="surmilanodi5@gmail.com"

# EMAIL SERVICE OPTION 1 - SMTP (e.g., Gmail App Password, Brevo, Zoho, Postmark SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# EMAIL SERVICE OPTION 2 - Resend HTTPS API (used if SMTP_* is not set)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
